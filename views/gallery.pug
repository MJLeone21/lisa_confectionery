extends layout

block content
  section.page-header
    .wrap
      h1 Gallery
      p A look at cakes and treats that have left our kitchen. Follow us on Instagram and TikTok for new bakes every week.

  section.band-ivory
    .wrap
      .gallery
        figure
          img(src="/assets/wedding2_floral_wood.jpg" alt="Floral wedding cake")
          figcaption Wedding
        figure
          img(src="/assets/bride_cake.jpg" alt="Bride to be cake")
          figcaption Bridal Shower
        figure
          img(src="/assets/babyshower_moon.jpg" alt="Moon themed baby shower cake")
          figcaption Baby Shower
        figure
          img(src="/assets/intro_red_gold.jpg" alt="Red and gold introduction cake")
          figcaption Introduction
        figure
          img(src="/assets/bento_box.jpg" alt="Bento box cake and cupcakes")
          figcaption Bento Box
        figure
          img(src="/assets/boys_tiered2_batman.jpg" alt="Batman themed tiered birthday cake")
          figcaption Children's
        figure
          img(src="/assets/wedding3_white.jpg" alt="White tiered wedding cake")
          figcaption Wedding
        figure
          img(src="/assets/cupcakes.jpg" alt="Decorated cupcakes")
          figcaption Cupcakes
        figure
          img(src="/assets/intro_hats.jpg" alt="Top hat introduction cakes")
          figcaption Introduction
        figure
          img(src="/assets/girls_cakes3.jpg" alt="Easter themed cake")
          figcaption Easter
        figure
          img(src="/assets/bento_cakes.jpg" alt="Bento cake with hand-piped illustration")
          figcaption Bento Cake
        figure
          img(src="/assets/glazed_doughnuts.jpg" alt="Box of glazed doughnuts")
          figcaption Doughnuts
        figure
          img(src="/assets/bridal_pink.jpg" alt="Pink and gold bridal shower cake")
          figcaption Bridal Shower
        figure
          img(src="/assets/wedding4_red_roses.jpg" alt="Wedding cake with red roses")
          figcaption Wedding
        figure
          img(src="/assets/girls_tiered2_purple.jpg" alt="Purple princess themed cake")
          figcaption Children's
        figure
          img(src="/assets/babyshower_bears.jpg" alt="Teddy bear baby shower cake")
          figcaption Baby Shower

  section.band-cream
    .wrap
      .section-head
        .kicker @lisa_confectioneryy
        h2 From our Instagram feed
        p These are recent bakes shared on our Instagram — follow along for behind-the-scenes and new designs.
      .ig-strip
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/wedding2_floral_wood.jpg" alt="Instagram post")
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/wedding3_white.jpg" alt="Instagram post")
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/bridal_pink.jpg" alt="Instagram post")
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/babyshower_bears.jpg" alt="Instagram post")
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/intro_red_gold.jpg" alt="Instagram post")
        a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener"): img(src="/assets/cupcakes.jpg" alt="Instagram post")
      div(style="text-align:center; margin-top:26px;")
        a.btn.btn-dark(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener") Follow @lisa_confectioneryy →
