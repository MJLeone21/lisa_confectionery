extends layout

block content
  section.page-header
    .wrap
      h1 Contact &amp; location
      p By appointment only — reach out ahead of your date, especially for tiered and wedding cakes.

  section.band-ivory
    .wrap.contact-grid
      div
        ul.contact-list
          li
            span.ic 📞
            div
              strong Phone / WhatsApp
              a(href="tel:+256706200567") 0706 200567
              |  &middot;
              a(href="tel:+256786200567") 0786 200567
              |  &middot;
              a(href="tel:+256772589450") 0772 589450
          li
            span.ic ✉
            div
              strong Email
              a(href="mailto:lisaconfectionery@gmail.com") lisaconfectionery@gmail.com
          li
            span.ic 📍
            div
              strong Location
              span Kanyanya Road, Kawempe Division, Kampala, Uganda
          li
            span.ic 🕒
            div
              strong Hours
              span By appointment
        .social-row
          a(href="https://www.instagram.com/lisa_confectioneryy" target="_blank" rel="noopener") Instagram
          a(href="https://www.tiktok.com/@lisa_confectioneryy" target="_blank" rel="noopener") TikTok @lisa_confectioneryy
          a(href="https://twitter.com/lisa_treats256" target="_blank" rel="noopener") Twitter @lisa_treats256
        div(style="margin-top:26px;")
          a.btn.btn-gold(href="/book") Book a Cake
      .map-frame
        iframe(title="Lisa Confectionery location map" loading="lazy" src="https://www.google.com/maps?q=Kanyanya+Road,+Kawempe,+Kampala,+Uganda&output=embed")

