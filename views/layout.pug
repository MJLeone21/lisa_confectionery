doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    meta(name="description" content=(description || "Lisa Confectionery — custom cakes and baked treats in Kampala, Uganda."))
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/styles.css")
    block head
  body
    a.skip(href="#main") Skip to content
    include partials/nav.pug
    main#main
      block content
    include partials/footer.pug
    a.wa-float(href=`https://wa.me/${whatsappNumber}?text=Hi%20Lisa%20Confectionery%2C%20I%27d%20like%20to%20order%20a%20cake` target="_blank" rel="noopener" aria-label="Chat on WhatsApp") 💬
    script(src="/js/main.js")
    block scripts
